<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="PsdzRpcServer"/>

  <!-- Nur der hoechste Eintrag ist relevant, er gilt fuer Windows 10 und 11.
	   Damit meldet GetVersionEx (und unter .NET Framework Environment.OSVersion)
	   die tatsaechliche Betriebssystemversion. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
	<application>
	  <!-- Windows 10 / Windows 11 -->
	  <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
	</application>
  </compatibility>
</assembly>
